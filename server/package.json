{
  "name": "server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env src/index.ts",
    "db:reset": "node --env-file-if-exists=.env db/reset.ts",
    "db:make-migration": "knex --knexfile knexfile.ts migrate:make -x ts",
    "typecheck": "tsc"
  },
  "dependencies": {
    "express": "^5.3.0",
    "knex": "^3.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}
